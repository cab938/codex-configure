+/// A model selector with an explicit provider namespace.
+///
+/// The original selector remains the caller's responsibility. This borrowed
+/// representation only separates the provider ID from the model name that
+/// should be sent over the wire.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct QualifiedModel<'a> {
+    /// ID used to look up the configured model provider.
+    pub provider_id: &'a str,
+    /// Model name to send to the selected provider.
+    pub wire_model: &'a str,
+}
+
+/// Errors returned when a model selector looks qualified but is malformed.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum QualifiedModelError {
+    /// The provider portion before ` → ` is empty.
+    EmptyProvider,
+    /// The model portion after ` → ` is empty.
+    EmptyModel,
+    /// The provider portion contains characters that cannot form a namespace.
+    MalformedNamespace,
+}
+
+impl fmt::Display for QualifiedModelError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let message = match self {
+            Self::EmptyProvider => "qualified model provider namespace must not be empty",
+            Self::EmptyModel => "qualified model must not be empty after the provider namespace",
+            Self::MalformedNamespace => {
+                "qualified model provider namespace is malformed; use provider → model"
+            }
+        };
+        f.write_str(message)
+    }
+}
+
+impl std::error::Error for QualifiedModelError {}
+
+/// Parses an optional provider-qualified model selector.
+///
+/// Selectors without ` → ` return `Ok(None)` for backwards compatibility. The
+/// former `::` separator remains readable so persisted selectors can migrate.
+/// For qualified selectors, only the first separator is significant, so model
+/// names may contain `/` or additional separators. Provider IDs must be
+/// non-empty, contain no whitespace, `/`, `\\`, or `:` characters, and the wire
+/// model must be non-empty. The parser never includes selector contents in an
+/// error so a caller can safely surface parse failures without echoing
+/// sensitive input.
+pub fn parse_qualified_model(
+    selector: &str,
+) -> Result<Option<QualifiedModel<'_>>, QualifiedModelError> {
+    let Some((provider_id, wire_model)) = selector
+        .split_once(QUALIFIED_MODEL_SEPARATOR)
+        .or_else(|| selector.split_once(LEGACY_QUALIFIED_MODEL_SEPARATOR))
+    else {
+        return Ok(None);
+    };
+
+    if provider_id.is_empty() {
+        return Err(QualifiedModelError::EmptyProvider);
+    }
+    if wire_model.trim().is_empty() {
+        return Err(QualifiedModelError::EmptyModel);
+    }
+    if provider_id
+        .chars()
+        .any(|character| character.is_whitespace() || matches!(character, '/' | '\\' | ':'))
+    {
+        return Err(QualifiedModelError::MalformedNamespace);
+    }
+
+    Ok(Some(QualifiedModel {
+        provider_id,
+        wire_model,
+    }))
+}
+
+/// Returns the canonical arrow-qualified spelling for a valid selector.
+pub fn canonicalize_qualified_model(selector: &str) -> Result<Option<String>, QualifiedModelError> {
+    parse_qualified_model(selector).map(|qualified| {
+        qualified.map(|qualified| {
+            format!(
+                "{}{QUALIFIED_MODEL_SEPARATOR}{}",
+                qualified.provider_id, qualified.wire_model
+            )
+        })
+    })
+}
+
+/// Joins a provider namespace and wire model using the canonical separator.
+pub fn format_qualified_model(provider_id: &str, wire_model: &str) -> String {
+    format!("{provider_id}{QUALIFIED_MODEL_SEPARATOR}{wire_model}")
+}
