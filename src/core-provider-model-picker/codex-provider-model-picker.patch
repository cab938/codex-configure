+use super::*;
+use codex_http_client::OutboundProxyPolicy;
+use codex_models_manager::ModelsManagerConfig;
+use codex_models_manager::bundled_models_response;
+use codex_models_manager::manager::RefreshStrategy;
+use codex_models_manager::manager::StaticModelsManager;
+use codex_protocol::openai_models::ModelsResponse;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn qualified_manager_uses_wire_suffix_for_metadata_and_keeps_picker_identity() {
+    let inner = Arc::new(StaticModelsManager::new(
+        None,
+        bundled_models_response().expect("bundled model catalog should load"),
+    ));
+    let manager = QualifiedModelsManager {
+        provider_id: "umich-toolkit".to_string(),
+        inner,
+    };
+    let http_client_factory = HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault);
+    let selector = Some("umich-toolkit::gpt-5.6-sol".to_string());
+
+    let selected = manager
+        .get_default_model(
+            &selector,
+            /*allow_provider_model_fallback*/ false,
+            RefreshStrategy::Offline,
+            http_client_factory.clone(),
+        )
+        .await;
+    let info = manager
+        .get_model_info(selected.as_str(), &ModelsManagerConfig::default())
+        .await;
+
+    assert_eq!(selected, "umich-toolkit → gpt-5.6-sol");
+    assert_eq!(info.slug, "gpt-5.6-sol");
+
+    let presets = manager
+        .list_models(RefreshStrategy::Offline, http_client_factory)
+        .await;
+    assert!(
+        presets
+            .iter()
+            .all(|preset| preset.model.starts_with("umich-toolkit → "))
+    );
+}
+
+#[test]
+fn provider_runtime_constructs_a_provider_bound_manager() {
+    let runtime = ProviderRuntime::new(
+        "umich-toolkit".to_string(),
+        ModelProviderInfo {
+            name: "umich-toolkit".to_string(),
+            base_url: Some("https://toolkit.example/v1".to_string()),
+            ..Default::default()
+        },
+        None,
+        PathBuf::from("/tmp/codex-provider-runtime-test"),
+        Some(ModelsResponse::default()),
+    );
+
+    assert_eq!(runtime.provider.info().name, "umich-toolkit");
+}
