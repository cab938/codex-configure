+fn apply_persisted_resume_model_provider(
+    request_overrides: Option<&HashMap<String, serde_json::Value>>,
+    typesafe_overrides: &mut ConfigOverrides,
+    persisted_settings: &PersistedResumeSettings,
+) {
+    if has_model_resume_override(request_overrides, typesafe_overrides) {
+        return;
+    }
+    // A TurnContext can carry a model without a provider. Leave that case to the
+    // persisted SessionMeta fallback so we do not turn an unqualified model into an
+    // override that suppresses restoration of the original provider.
+    let Some(model_provider_id) = persisted_settings.model_provider_id.as_ref() else {
+        return;
+    };
+    typesafe_overrides.model = persisted_settings.model.clone();
+    typesafe_overrides.model_provider = Some(model_provider_id.clone());
+}
