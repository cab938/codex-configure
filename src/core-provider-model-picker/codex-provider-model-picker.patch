+async fn provider_selection_commits_provider_and_snapshot_atomically() {
+    let mut configuration = make_session_configuration_for_tests().await;
+    let mut config = (*configuration.original_config_do_not_use).clone();
+    config.model_providers.insert(
+        "umich-toolkit".to_string(),
+        ModelProviderInfo {
+            name: "umich-toolkit".to_string(),
+            base_url: Some("https://toolkit.example/v1".to_string()),
+            ..Default::default()
+        },
+    );
+    configuration.original_config_do_not_use = Arc::new(config);
+
+    let updated = configuration
+        .apply(
+            &SessionSettingsUpdate {
+                step_settings: StepSettingsUpdate {
+                    model: Some("umich-toolkit → gpt-5.6-sol".to_string()),
+                    ..Default::default()
+                },
+                ..Default::default()
+            },
+            &[],
+        )
+        .expect("configured provider selection should apply");
+    assert_eq!(
+        updated.original_config_do_not_use.model_provider_id,
+        "umich-toolkit"
+    );
+    assert_eq!(
+        updated.thread_settings_snapshot(&[]).model,
+        "umich-toolkit → gpt-5.6-sol"
+    );
+    assert_eq!(
+        updated.thread_settings_snapshot(&[]).model_provider_id,
+        "umich-toolkit"
+    );
+
+    let before = configuration.thread_settings_snapshot(&[]);
+    assert!(
+        configuration
+            .apply(
+                &SessionSettingsUpdate {
+                    step_settings: StepSettingsUpdate {
+                        model: Some("not-configured → gpt-5.6-sol".to_string()),
+                        ..Default::default()
+                    },
+                    ..Default::default()
+                },
+                &[],
+            )
+            .is_err()
+    );
+    assert_eq!(configuration.thread_settings_snapshot(&[]), before);
+    assert!(
+        configuration
+            .apply(
+                &SessionSettingsUpdate {
+                    step_settings: StepSettingsUpdate {
+                        model: Some("umich-toolkit → ".to_string()),
+                        ..Default::default()
+                    },
+                    ..Default::default()
+                },
+                &[],
+            )
+            .is_err()
+    );
+    assert_eq!(configuration.thread_settings_snapshot(&[]), before);
+}
