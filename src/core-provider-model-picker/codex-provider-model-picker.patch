+fn model_selector_matches(candidate: &str, requested: &str) -> bool {
+    if candidate == requested {
+        return true;
+    }
+    match (
+        parse_qualified_model(candidate).ok().flatten(),
+        parse_qualified_model(requested).ok().flatten(),
+    ) {
+        (Some(candidate), Some(requested)) => {
+            candidate.provider_id == requested.provider_id
+                && candidate.wire_model == requested.wire_model
+        }
+        (Some(candidate), None) => candidate.wire_model == requested,
+        (None, Some(requested)) => candidate == requested.wire_model,
+        (None, None) => false,
+    }
+}
