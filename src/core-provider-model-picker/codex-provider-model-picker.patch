+    let mut resumed_config = (*turn_context.config).clone();
+    resumed_config.model_provider_id = "umich-toolkit".to_string();
+    turn_context.config = Arc::new(resumed_config);
+
+    let rollout_items = vec![
+        RolloutItem::SessionMeta(SessionMetaLine {
+            meta: SessionMeta {
+                model_provider: Some("openai".to_string()),
+                ..SessionMeta::default()
+            },
+            git: None,
+        }),
+        RolloutItem::ResponseItem(user_message("openai question").into()),
+        RolloutItem::ResponseItem(encrypted_reasoning("rs-openai").into()),
+        RolloutItem::ResponseItem(assistant_message("openai answer").into()),
+        RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(
+            codex_protocol::protocol::ThreadSettingsAppliedEvent {
+                thread_settings: umich_settings,
+            },
+        )),
+        RolloutItem::ResponseItem(user_message("umich question").into()),
+        RolloutItem::ResponseItem(encrypted_reasoning("rs-umich").into()),
+        RolloutItem::ResponseItem(assistant_message("umich answer").into()),
+    ];
+
+    let reconstructed = session
+        .reconstruct_history_from_rollout(&turn_context, &rollout_items)
+        .await;
+
+    assert_eq!(
+        reconstructed.history,
+        annotated(vec![
+            user_message("openai question"),
+            assistant_message("openai answer"),
+            user_message("umich question"),
+            encrypted_reasoning("rs-umich"),
+            assistant_message("umich answer"),
+        ])
+    );
+
+    let (session, turn_context) = make_session_and_context().await;
+    let umich_settings = {
+        let mut settings = session.thread_settings_snapshot().await;
+        settings.model_provider_id = "umich-toolkit".to_string();
+        settings.model = "umich-toolkit → gpt-5.6-terra".to_string();
+        settings
+    };
+    let openai_settings = session.thread_settings_snapshot().await;
+
+    let rollout_items = vec![
+        RolloutItem::SessionMeta(SessionMetaLine {
+            meta: SessionMeta {
+                model_provider: Some("umich-toolkit".to_string()),
+                ..SessionMeta::default()
+            },
+            git: None,
+        }),
+        RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(
+            codex_protocol::protocol::ThreadSettingsAppliedEvent {
+                thread_settings: umich_settings,
+            },
+        )),
+        RolloutItem::ResponseItem(user_message("umich question").into()),
+        RolloutItem::ResponseItem(encrypted_reasoning("rs-umich").into()),
+        RolloutItem::ResponseItem(assistant_message("umich answer").into()),
+        RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(
+            codex_protocol::protocol::ThreadSettingsAppliedEvent {
+                thread_settings: openai_settings,
+            },
+        )),
+        RolloutItem::ResponseItem(user_message("return question").into()),
+    ];
+
+    let reconstructed = session
+        .reconstruct_history_from_rollout(&turn_context, &rollout_items)
+        .await;
+
+    assert_eq!(
+        reconstructed.history,
+        annotated(vec![
+            user_message("umich question"),
+            assistant_message("umich answer"),
+            user_message("return question"),
