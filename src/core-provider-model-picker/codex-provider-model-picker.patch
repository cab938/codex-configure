+//! Provider-scoped runtime state used by thread and turn settings.
+
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use codex_http_client::HttpClientFactory;
+use codex_login::AuthManager;
+use codex_model_provider::SharedModelProvider;
+use codex_model_provider::create_model_provider;
+use codex_model_provider_info::ModelProviderInfo;
+use codex_model_provider_info::canonicalize_qualified_model;
+use codex_model_provider_info::format_qualified_model;
+use codex_model_provider_info::parse_qualified_model;
+use codex_models_manager::manager::ModelsManager;
+use codex_models_manager::manager::ModelsManagerFuture;
+use codex_models_manager::manager::RefreshStrategy;
+use codex_models_manager::manager::SharedModelsManager;
+use codex_protocol::config_types::CollaborationModeMask;
+use codex_protocol::openai_models::ModelInfo;
+use codex_protocol::openai_models::ModelPreset;
+use codex_protocol::openai_models::ModelsResponse;
+use tokio::sync::TryLockError;
+
+/// The provider and model catalog selected for a thread.
+#[derive(Clone)]
+pub(crate) struct ProviderRuntime {
+    pub(crate) provider: SharedModelProvider,
+    pub(crate) models_manager: SharedModelsManager,
+}
+
+impl ProviderRuntime {
+    pub(crate) fn new(
+        provider_id: String,
+        provider_info: ModelProviderInfo,
+        auth_manager: Option<Arc<AuthManager>>,
+        codex_home: PathBuf,
+        model_catalog: Option<ModelsResponse>,
+    ) -> Self {
+        let provider = create_model_provider(provider_info, auth_manager);
+        let models_manager = provider.models_manager(codex_home, model_catalog);
+        let models_manager = Arc::new(QualifiedModelsManager {
+            provider_id: provider_id.clone(),
+            inner: models_manager,
+        });
+        Self {
+            provider,
+            models_manager,
+        }
+    }
+}
+
+/// Adapts a provider's manager at the Core boundary.
+///
+/// Model selectors remain qualified for picker and thread state, while all
+/// lookups and provider-owned catalog operations use the wire model suffix.
+#[derive(Debug)]
+pub(crate) struct QualifiedModelsManager {
+    pub(crate) provider_id: String,
+    pub(crate) inner: SharedModelsManager,
+}
+
+impl QualifiedModelsManager {
+    fn wire_model<'a>(&self, model: &'a str) -> &'a str {
+        parse_qualified_model(model)
+            .ok()
+            .flatten()
+            .map_or(model, |qualified| qualified.wire_model)
+    }
+
+    fn qualify_presets(&self, presets: &mut [ModelPreset]) {
+        for preset in presets {
+            preset.model = match canonicalize_qualified_model(&preset.model) {
+                Ok(Some(model)) => model,
+                Ok(None) => format_qualified_model(&self.provider_id, &preset.model),
+                Err(_) => continue,
+            };
+        }
+    }
+}
+
+impl ModelsManager for QualifiedModelsManager {
+    fn list_models(
+        &self,
+        refresh_strategy: RefreshStrategy,
+        http_client_factory: HttpClientFactory,
+    ) -> ModelsManagerFuture<'_, Vec<ModelPreset>> {
+        Box::pin(async move {
+            let mut presets = self
+                .inner
+                .list_models(refresh_strategy, http_client_factory)
+                .await;
+            self.qualify_presets(&mut presets);
+            presets
+        })
+    }
+
+    fn get_default_model<'a>(
+        &'a self,
+        model: &'a Option<String>,
+        allow_provider_model_fallback: bool,
+        refresh_strategy: RefreshStrategy,
+        http_client_factory: HttpClientFactory,
+    ) -> ModelsManagerFuture<'a, String> {
+        let wire_model = model.as_deref().map(|model| self.wire_model(model));
+        let wire_model = wire_model.map(str::to_string);
+        Box::pin(async move {
+            let selected = self
+                .inner
+                .get_default_model(
+                    &wire_model,
+                    allow_provider_model_fallback,
+                    refresh_strategy,
+                    http_client_factory,
+                )
+                .await;
+            if model.is_some() {
+                model
+                    .as_deref()
+                    .and_then(|model| canonicalize_qualified_model(model).ok().flatten())
+                    .unwrap_or_else(|| model.clone().unwrap_or(selected))
+            } else {
+                format_qualified_model(&self.provider_id, &selected)
+            }
+        })
+    }
+
+    fn raw_model_catalog(
+        &self,
+        refresh_strategy: RefreshStrategy,
+        http_client_factory: HttpClientFactory,
+    ) -> ModelsManagerFuture<'_, ModelsResponse> {
+        self.inner
+            .raw_model_catalog(refresh_strategy, http_client_factory)
+    }
+
+    fn get_remote_models(&self) -> ModelsManagerFuture<'_, Vec<ModelInfo>> {
+        self.inner.get_remote_models()
+    }
+
+    fn try_get_remote_models(&self) -> std::result::Result<Vec<ModelInfo>, TryLockError> {
+        self.inner.try_get_remote_models()
+    }
+
+    fn auth_manager(&self) -> Option<&AuthManager> {
+        self.inner.auth_manager()
+    }
+
+    fn list_collaboration_modes(&self) -> Vec<CollaborationModeMask> {
+        self.inner.list_collaboration_modes()
+    }
+
+    fn refresh_if_new_etag(
+        &self,
+        etag: String,
+        http_client_factory: HttpClientFactory,
+    ) -> ModelsManagerFuture<'_, ()> {
+        self.inner.refresh_if_new_etag(etag, http_client_factory)
+    }
+
+    fn get_model_info<'a>(
+        &'a self,
+        model: &'a str,
+        config: &'a codex_models_manager::ModelsManagerConfig,
+    ) -> ModelsManagerFuture<'a, ModelInfo> {
+        self.inner.get_model_info(self.wire_model(model), config)
+    }
+}
+
+#[cfg(test)]
+#[path = "provider_runtime_tests.rs"]
+mod tests;
