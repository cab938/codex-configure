diff --git a/codex-rs/core/src/external_provider_catalogs.rs b/codex-rs/core/src/external_provider_catalogs.rs
new file mode 100644
index 0000000000..f9552c878d
--- /dev/null
+++ b/codex-rs/core/src/external_provider_catalogs.rs
@@ -0,0 +1,261 @@
+//! Startup-loaded provider descriptors owned by codex-configure.
+//!
+//! The launcher writes one descriptor per provider beneath
+//! `$CODEX_HOME/codex-configure/providers.d`. Keeping discovery here lets the
+//! normal Codex config and provider runtime stay unchanged apart from a small
+//! merge and catalog lookup at startup.
+
+use codex_model_provider_info::ModelProviderInfo;
+use codex_model_provider_info::built_in_model_providers;
+use codex_protocol::openai_models::ModelsResponse;
+use std::collections::HashMap;
+use std::collections::HashSet;
+use std::fs;
+use std::path::{Path, PathBuf};
+
+const CONFIGURE_DIR: &str = "codex-configure";
+const PROVIDERS_DIR: &str = "providers.d";
+const DESCRIPTOR_EXTENSION: &str = "toml";
+
+/// Providers and catalogs that were valid at startup.
+#[derive(Debug, Default)]
+pub(crate) struct LoadedExternalProviders {
+    pub(crate) providers: HashMap<String, ModelProviderInfo>,
+    pub(crate) catalogs: HashMap<String, ModelsResponse>,
+    pub(crate) warnings: Vec<String>,
+}
+
+/// Load all valid codex-configure provider descriptors in deterministic order.
+///
+/// A malformed descriptor is deliberately non-fatal: startup retains the
+/// built-in providers and reports an actionable warning. No external provider
+/// is returned without a non-empty, successfully parsed static catalog.
+pub(crate) fn load(
+    codex_home: &Path,
+    configured_provider_ids: &HashSet<String>,
+) -> LoadedExternalProviders {
+    let directory = codex_home.join(CONFIGURE_DIR).join(PROVIDERS_DIR);
+    let mut result = LoadedExternalProviders::default();
+    let mut descriptors = match fs::read_dir(&directory) {
+        Ok(entries) => entries
+            .filter_map(|entry| match entry {
+                Ok(entry) if entry.file_type().is_ok_and(|kind| kind.is_file()) => {
+                    let path = entry.path();
+                    (path.extension().and_then(|ext| ext.to_str()) == Some(DESCRIPTOR_EXTENSION))
+                        .then_some(path)
+                }
+                Ok(_) => None,
+                Err(error) => {
+                    result.warnings.push(format!(
+                        "could not inspect an external provider descriptor in `{}`: {error}",
+                        directory.display()
+                    ));
+                    None
+                }
+            })
+            .collect::<Vec<_>>(),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return result,
+        Err(error) => {
+            result.warnings.push(format!(
+                "could not read external provider descriptor directory `{}`: {error}",
+                directory.display()
+            ));
+            return result;
+        }
+    };
+    descriptors.sort_by(|left, right| left.file_name().cmp(&right.file_name()));
+
+    let reserved_ids: HashSet<String> = built_in_model_providers(None).into_keys().collect();
+    for descriptor in descriptors {
+        match load_descriptor(&descriptor) {
+            Ok((provider_id, provider, catalog)) => {
+                let reason = if reserved_ids.contains(&provider_id) {
+                    Some(format!("provider ID `{provider_id}` is reserved by Codex"))
+                } else if configured_provider_ids.contains(&provider_id) {
+                    Some(format!("provider ID `{provider_id}` is already configured"))
+                } else if result.providers.contains_key(&provider_id) {
+                    Some(format!("provider ID `{provider_id}` is duplicated"))
+                } else {
+                    None
+                };
+                if let Some(reason) = reason {
+                    skip(&mut result.warnings, &descriptor, &reason);
+                    continue;
+                }
+                result.providers.insert(provider_id.clone(), provider);
+                result.catalogs.insert(provider_id, catalog);
+            }
+            Err(reason) => skip(&mut result.warnings, &descriptor, &reason),
+        }
+    }
+    result
+}
+
+fn load_descriptor(
+    descriptor_path: &Path,
+) -> Result<(String, ModelProviderInfo, ModelsResponse), String> {
+    let text = fs::read_to_string(descriptor_path)
+        .map_err(|error| format!("could not read descriptor: {error}"))?;
+    let root = toml::from_str::<toml::Table>(&text)
+        .map_err(|error| format!("descriptor is not valid TOML: {error}"))?;
+    if !root.contains_key("model_providers") {
+        return Err("descriptor must contain exactly one `[model_providers.<id>]` table".into());
+    }
+    if root.keys().any(|key| {
+        !matches!(
+            key.as_str(),
+            "schema_version" | "kind" | "model_catalog_json" | "model_providers"
+        )
+    }) {
+        return Err("descriptor contains unsupported top-level fields".into());
+    }
+    let providers = root
+        .get("model_providers")
+        .and_then(toml::Value::as_table)
+        .ok_or_else(|| "`model_providers` must be a TOML table".to_string())?;
+    if providers.len() != 1 {
+        return Err("descriptor must contain exactly one `[model_providers.<id>]` table".into());
+    }
+    let (provider_id, provider_value) = providers.iter().next().expect("one provider checked");
+    validate_provider_id(provider_id)?;
+    let provider_table = provider_value
+        .as_table()
+        .ok_or_else(|| format!("[model_providers.{provider_id}] must be a TOML table"))?;
+    let catalog_value = root
+        .get("model_catalog_json")
+        .and_then(toml::Value::as_str)
+        .filter(|path| !path.trim().is_empty())
+        .ok_or_else(|| "`model_catalog_json` must be a non-empty path".to_string())?;
+    let provider: ModelProviderInfo = toml::Value::Table(provider_table.clone())
+        .try_into()
+        .map_err(|error| format!("provider definition is invalid: {error}"))?;
+    if provider.name.trim().is_empty() {
+        return Err("provider name must not be empty".into());
+    }
+    if provider.aws.is_some() {
+        return Err("provider aws is only supported for built-in Bedrock providers".into());
+    }
+    provider
+        .validate()
+        .map_err(|error| format!("provider definition is invalid: {error}"))?;
+
+    let catalog_path = resolve_catalog_path(descriptor_path, catalog_value);
+    let catalog_text = fs::read_to_string(&catalog_path).map_err(|error| {
+        format!(
+            "could not read model catalog `{}`: {error}",
+            catalog_path.display()
+        )
+    })?;
+    let catalog: ModelsResponse = serde_json::from_str(&catalog_text).map_err(|error| {
+        format!(
+            "model catalog `{}` is not valid Codex ModelsResponse JSON: {error}",
+            catalog_path.display()
+        )
+    })?;
+    if catalog.models.is_empty() {
+        return Err(format!(
+            "model catalog `{}` must contain at least one model",
+            catalog_path.display()
+        ));
+    }
+    Ok((provider_id.clone(), provider, catalog))
+}
+
+fn validate_provider_id(provider_id: &str) -> Result<(), String> {
+    if provider_id.is_empty()
+        || !provider_id
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_'))
+    {
+        return Err("provider ID must match ^[A-Za-z0-9_-]+$".into());
+    }
+    Ok(())
+}
+
+fn resolve_catalog_path(descriptor_path: &Path, configured_path: &str) -> PathBuf {
+    let path = Path::new(configured_path);
+    if path.is_absolute() {
+        path.to_path_buf()
+    } else {
+        descriptor_path
+            .parent()
+            .unwrap_or_else(|| Path::new("."))
+            .join(path)
+    }
+}
+
+fn skip(warnings: &mut Vec<String>, descriptor: &Path, reason: &str) {
+    warnings.push(format!(
+        "external provider descriptor `{}` skipped: {reason}",
+        descriptor.display()
+    ));
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::fs;
+
+    fn write_catalog(path: &Path, empty: bool) {
+        let mut catalog = codex_models_manager::bundled_models_response().expect("bundled catalog");
+        if empty {
+            catalog.models.clear();
+        }
+        fs::write(path, serde_json::to_string(&catalog).expect("catalog JSON")).expect("catalog");
+    }
+
+    fn descriptor(path: &Path, id: &str, catalog: &str) {
+        fs::write(
+            path,
+            format!(
+                "schema_version = 1\nkind = \"external\"\nmodel_catalog_json = \"{catalog}\"\n\n[model_providers.{id}]\nname = \"Test\"\nbase_url = \"https://example.test/v1\"\n\n[model_providers.{id}.env_http_headers]\nx-example-api-key = \"TEST_KEY\"\n"
+            ),
+        )
+        .expect("descriptor");
+    }
+
+    #[test]
+    fn loads_static_catalogs_relative_to_descriptor_and_sorts_filenames() {
+        let temp = tempfile::tempdir().expect("tempdir");
+        let providers = temp.path().join(CONFIGURE_DIR).join(PROVIDERS_DIR);
+        fs::create_dir_all(&providers).expect("providers");
+        let catalogs = providers.join("catalogs");
+        fs::create_dir_all(&catalogs).expect("catalogs");
+        write_catalog(&catalogs.join("a.json"), false);
+        write_catalog(&catalogs.join("b.json"), false);
+        descriptor(&providers.join("01-first.toml"), "first", "catalogs/a.json");
+        descriptor(
+            &providers.join("02-second.toml"),
+            "second",
+            "catalogs/b.json",
+        );
+
+        let loaded = load(temp.path(), &HashSet::new());
+        assert_eq!(loaded.providers.len(), 2);
+        assert_eq!(loaded.catalogs.len(), 2);
+        assert!(loaded.warnings.is_empty());
+    }
+
+    #[test]
+    fn skips_missing_empty_malformed_duplicate_and_reserved_descriptors() {
+        let temp = tempfile::tempdir().expect("tempdir");
+        let providers = temp.path().join(CONFIGURE_DIR).join(PROVIDERS_DIR);
+        fs::create_dir_all(&providers).expect("providers");
+        write_catalog(&providers.join("good.json"), false);
+        write_catalog(&providers.join("empty.json"), true);
+        descriptor(&providers.join("01-good.toml"), "good", "good.json");
+        descriptor(&providers.join("02-duplicate.toml"), "good", "good.json");
+        descriptor(&providers.join("03-reserved.toml"), "openai", "good.json");
+        descriptor(&providers.join("04-empty.toml"), "empty", "empty.json");
+        fs::write(providers.join("05-malformed.toml"), "not = [valid").expect("malformed");
+
+        let loaded = load(temp.path(), &HashSet::new());
+        assert_eq!(loaded.providers.len(), 1);
+        assert_eq!(loaded.catalogs.len(), 1);
+        assert_eq!(
+            loaded.providers.keys().next().map(String::as_str),
+            Some("good")
+        );
+        assert_eq!(loaded.warnings.len(), 4);
+    }
+}
