+async fn list_models_aggregates_qualified_umich_toolkit_catalog() -> Result<()> {
+    let toolkit_model: ModelInfo = serde_json::from_value(json!({
+        "slug": "um-model",
+        "display_name": "U-M Toolkit model",
+        "description": "Discovery-only U-M model",
+        "default_reasoning_level": "low",
+        "supported_reasoning_levels": [{"effort": "low", "description": "Low"}],
+        "shell_type": "shell_command",
+        "visibility": "list",
+        "supported_in_api": true,
+        "priority": 0,
+        "upgrade": {
+            "model": "um-upgrade",
+            "migration_markdown": "Use the newer U-M model."
+        },
+        "support_verbosity": false,
+        "default_verbosity": null,
+        "apply_patch_tool_type": null,
+        "truncation_policy": {"mode": "bytes", "limit": 10000},
+        "context_window": 272000,
+        "max_context_window": 272000,
+        "experimental_supported_tools": []
+    }))?;
+    let codex_home = TempDir::new()?;
+    write_models_cache(codex_home.path())?;
+    let providers_dir = codex_home.path().join("codex-configure/providers.d");
+    let catalogs_dir = codex_home.path().join("codex-configure/catalogs");
+    std::fs::create_dir_all(&providers_dir)?;
+    std::fs::create_dir_all(&catalogs_dir)?;
+    std::fs::write(
+        catalogs_dir.join("umich.json"),
+        serde_json::to_vec(&ModelsResponse {
+            models: vec![toolkit_model],
+        })?,
+    )?;
+    std::fs::write(
+        providers_dir.join("umich-toolkit.toml"),
+        r#"schema_version = 1
+kind = "external"
+model_catalog_json = "../catalogs/umich.json"
+
+[model_providers.umich-toolkit]
+name = "U-M Toolkit"
+base_url = "https://example.test/v1"
+
+[model_providers.umich-toolkit.env_http_headers]
+x-portkey-api-key = "UMICH_TOOLKIT_API_KEY"
+"#,
+    )?;
+    std::fs::write(
+        codex_home.path().join("config.toml"),
+        format!(
+            r#"
+model = "gpt-5"
+approval_policy = "never"
+sandbox_mode = "read-only"
+"#
+        ),
+    )?;
+
+    let mut mcp = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .without_auto_env()
+        .build_initialized()
+        .await?;
+    let mut cursor = None;
+    let mut items = Vec::new();
+    loop {
+        let ModelListResponse {
+            data: page,
+            next_cursor,
+        } = mcp
+            .request(|request_id| ClientRequest::ModelList {
+                request_id,
+                params: ModelListParams {
+                    limit: Some(1),
+                    cursor: cursor.clone(),
+                    include_hidden: None,
+                },
+            })
+            .await?;
+        items.extend(page);
+        let Some(next_cursor) = next_cursor else {
+            break;
+        };
+        cursor = Some(next_cursor);
+    }
+
+    assert!(items.iter().any(|item| item.id == "umich-toolkit → um-model"));
+    assert!(items.iter().all(|item| item.id.contains(" → ")));
+    assert!(items.iter().all(|item| item.model.contains(" → ")));
+    let toolkit = items
+        .iter()
+        .find(|item| item.id == "umich-toolkit → um-model")
+        .expect("U-M Toolkit model should be listed");
+    assert_eq!(toolkit.display_name, "umich-toolkit → um-model");
+    assert_eq!(toolkit.upgrade.as_deref(), Some("umich-toolkit → um-upgrade"));
+    assert_eq!(
+        toolkit
+            .upgrade_info
+            .as_ref()
+            .map(|upgrade| upgrade.model.as_str()),
+        Some("umich-toolkit → um-upgrade")
+    );
+    Ok(())
+}
